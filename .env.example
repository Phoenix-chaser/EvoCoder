# Defaults are offline. Set credentials only in a local environment file.
EVOCODER_MODE=mock
EVOCODER_BASE_URL=
EVOCODER_API_KEY=
EVOCODER_MODEL=
EVOCODER_PROVIDER=compatible
EVOCODER_BILLING_MODE=token_usd
EVOCODER_DISABLE_THINKING=false
EVOCODER_BUDGET_USD=0
EVOCODER_INPUT_PRICE_PER_MILLION=0
EVOCODER_OUTPUT_PRICE_PER_MILLION=0
EVOCODER_MAX_OUTPUT_TOKENS=4096
EVOCODER_MAX_INPUT_BYTES=65536
EVOCODER_MODEL_TIMEOUT=60
EVOCODER_MAX_STEPS=16
EVOCODER_COMMAND_TIMEOUT=20
EVOCODER_SKILL_ROUTING=semantic
# Routing inputs: issue, public_shape (test structure), or public_preview (source excerpts).
EVOCODER_LIBRARY_ROUTE_CONTEXT=issue
EVOCODER_RECOVER_ACTIONS=true
EVOCODER_PUBLIC_CHECKPOINTS=false
EVOCODER_AUTHORED_CLI_CHECKS=false
EVOCODER_LIVE_SWITCH_FEEDBACK=false
EVOCODER_MAX_MEMORY_BYTES=16384
# 0 disables cache discounts; configure only from your provider's published tariff.
EVOCODER_CACHED_INPUT_PRICE_PER_MILLION=0
EVOCODER_IMAGE=python:3.12-slim
EVOCODER_STATE_DIR=.state
