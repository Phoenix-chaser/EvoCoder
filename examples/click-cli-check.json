      "source": "import enum\nimport click\nfrom click.testing import CliRunner\n\nMetal = enum.Enum(\"Metal\", [\"Ag\", \"Au\", \"Cu\"])\n\ndef run(case_sensitive, incomplete):\n    cmd = click.Command(\"tool\", params=[click.Option([\"-a\"], type=click.Choice(Metal, case_sensitive=case_sensitive))])\n    return CliRunner().invoke(cmd, env={\"_TOOL_COMPLETE\": \"bash_complete\",\n        \"COMP_WORDS\": f\"tool -a {incomplete}\", \"COMP_CWORD\": \"2\"})\n\n# case-sensitive: enum member names, normalized spelling\nassert run(True, \"A\").output == \"plain,Ag\\nplain,Au\\n\", run(True, \"A\").output\nassert run(True, \"Ag\").output == \"plain,Ag\\n\", run(True, \"Ag\").output\nassert run(True, \"a\").output == \"\", run(True, \"a\").output\n# case-insensitive: normalized lowercase names, case-insensitive match\nassert run(False, \"A\").output == \"plain,ag\\nplain,au\\n\", run(False, \"A\").output\nassert run(False, \"aG\").output == \"plain,ag\\n\", run(False, \"aG\").output\nassert run(False, \"c\").output == \"plain,cu\\n\", run(False, \"c\").output\n# str choices still work in both states\ndef run2(cs, incomplete):\n    cmd = click.Command(\"t\", params=[click.Option([\"-x\"], type=click.Choice([\"Foo\", \"Bar\"], case_sensitive=cs))])\n    return CliRunner().invoke(cmd, env={\"_TOOL_COMPLETE\": \"bash_complete\",\n        \"COMP_WORDS\": f\"t -x {incomplete}\", \"COMP_CWORD\": \"2\"})\nassert run2(False, \"f\").output == \"plain,foo\\n\", run2(False, \"f\").output\nassert run2(False, \"B\").output == \"plain,bar\\n\", run2(False, \"B\").output\nassert run2(True, \"F\").output == \"plain,Foo\\n\", run2(True, \"F\").output\nprint(\"ok\")\n",
