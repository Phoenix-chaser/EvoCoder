      "source": "import enum\nimport click\nfrom click.testing import CliRunner\n\nMetal = enum.Enum(\"Metal\", [\"Ag\", \"Au\", \"Cu\"])\n\ndef run(case_sensitive, incomplete):\n    cmd = click.Command(\"tool\", params=[click.Option([\"-a\"], type=click.Choice(Metal, case_sensitive=case_sensitive))])\n    return CliRunner().invoke(cmd, env={\"_TOOL_COMPLETE\": \"bash_complete\",\n        \"COMP_WORDS\": f\"tool -a {incomplete}\", \"COMP_CWORD\": \"2\"})\n\n# Required behavior absent from the public example: an incomplete token that\n# matches no choice must yield no completion records (only the record-ending\n# newline), and must not include unrelated choices. Each case is checked\n# independently so one failure cannot mask the others.\nfailures = []\nfor cs, inc in [(True, \"a\"), (True, \"aG\"), (True, \"c\"), (True, \"z\")]:\n    r = run(cs, inc)\n    got = r.output\n    lines = [l for l in got.splitlines() if l.strip()]\n    if r.exit_code != 0:\n        failures.append(f\"exit {r.exit_code} for cs={cs} inc={inc!r}: {got!r}\")\n    elif lines:\n        failures.append(f\"expected no completion records for cs={cs} inc={inc!r}, got {got!r}\")\n\nassert not failures, \"; \".join(failures)\nprint(\"ok\")\n",
