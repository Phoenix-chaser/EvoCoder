  "manual": {
    "name": "preserve-supplied-option-across-interfaces",
    "applicability": [
      "An optional argument or setting has a documented fallback. A supplied value may evaluate to false."
    ],
    "steps": [
      "Find the public contract for an absent value and determine which sentinel denotes absence.",
      "Trace an explicit value across all public interfaces sharing the option, including storage and restoration. Check sibling implementations and branches for empty or overfull inputs when they share the contract.",
      "Use the documented sentinel for fallback. Preserve supplied values and callbacks without testing their truthiness. When a fallback must be computed, compute it only on the missing path.",
      "Check a legitimate falsy value end to end on another documented path in addition to the public reproducer."
    ],
    "verification": [
      "Compare the actual value, type or object identity for absent, ordinary and valid falsy inputs. For a stored setting, verify the value after reading it back."
    ],
    "exclusions": [
      "A documented API that deliberately treats all empty inputs as missing."
    ],
    "counterexamples": [],
    "evidence_refs": [
      "evaluator-authored-before-pretest"
    ],
    "change_summary": "Frozen manual positive control for the pretest.",
    "parent": null
  },
